# Kopieer naar .env (niet in git) en vul een eigen wachtwoord in.
STUDIO_DB_WACHTWOORD=
STUDIO_DB_URL=postgres://studio:<wachtwoord>@127.0.0.1:5490/studio
# Productie-instantie van de generator (lokale kloon op een vaste commit)
STUDIO_GENERATOR=~/Developer/makelaarsplatform-productie
STUDIO_API_POORT=8480
STUDIO_WEB_POORT=5480
# Opslag aangeleverde bestanden (standaard data/opslag, niet in git)
# STUDIO_OPSLAG=
