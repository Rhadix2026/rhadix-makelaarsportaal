# /srv/makelaarsportaal/.env op de server (chmod 600, eigenaar de deploygebruiker). Nooit in git.
# Voor de testomgeving: /srv/makelaarsportaal-test/.env met eigen waarden.
COMPOSE_PROJECT_NAME=makelaarsportaal
MP_TAG=<korte studiocommit, zie deploy/bouw-images.sh>
MP_OMGEVING=productie
# De publieke herkomst, plus de SSH-tunnel van de noodtoegang (http://127.0.0.1:<MP_POORT>).
MP_HERKOMST=https://makelaarsportaal.rhadix.nl,http://127.0.0.1:8580
MP_POORT=8580
MP_DATA=/srv/makelaarsportaal
MP_MODELLEN=/srv/makelaarsportaal-modellen
# Lang en willekeurig, uniek per omgeving (bijvoorbeeld: openssl rand -base64 32 | tr -d '/+=').
MP_DB_WACHTWOORD=<vul in op de server>

# Resourcegrenzen per servertype. Zonder deze regels gelden de standaarden voor 8 kernen / 16 GB
# (db 1g, api 1536m, verwerker 6g, 6 kernen). cpus mag niet hoger zijn dan het aantal kernen.
# Hetzner CPX32 (4 vCPU, 8 GB, 4 GB swap), één actieve omgeving:
MP_DB_GEHEUGEN=768m
MP_DB_CPUS=2
MP_API_GEHEUGEN=1g
MP_API_CPUS=2
MP_VERWERKER_GEHEUGEN=4g
MP_VERWERKER_GEHEUGEN_SWAP=6g
MP_VERWERKER_CPUS=4
# Opschalen naar CPX42 (8 vCPU, 16 GB): de regels hierboven weglaten of verhogen, dan 'up -d'.

# Centrale Rhadix-login. Alleen de PUBLIEKE sleutel (PEM op één regel met \n, of base64), op te halen
# uit <platform>/api/auth/jwks. Productie: https://app.rhadix.nl met cookie rhadix_sso;
# test: https://app-staging.rhadix.nl met cookie rhadix_sso_staging.
MP_SSO_PLATFORM=https://app.rhadix.nl
MP_SSO_COOKIE=rhadix_sso
MP_SSO_SLEUTEL=<publieke sleutel van het platform>
MP_LOKALE_LOGIN=tunnel
